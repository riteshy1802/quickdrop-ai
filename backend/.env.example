# Existing root ../.env is read automatically. Optional backend/.env overrides it.
POSTGRES_DB=quickdrop
POSTGRES_USER=quickdrop
POSTGRES_PASSWORD=change_me_locally
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# Optional alternative; URL-encode reserved characters if constructing a URL yourself.
# DATABASE_URL=postgresql+asyncpg://quickdrop:replace_me@localhost:5432/quickdrop
# A future Compose backend uses POSTGRES_HOST=postgres instead of localhost.

# JSON array of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

GROQ_API_KEY=

# Temporary local-only read access. Never enable on a shared/public deployment.
APP_ENV=development
ENABLE_LOCAL_INTERNAL_READS=false


# PaySwift sandbox and durable worker
PAYSWIFT_BASE_URL=http://localhost:8081
PAYMENT_POLL_SECONDS=2
PAYMENT_MAX_ATTEMPTS=8

# LangGraph/Groq agent. Model selection is configurable; no SDK retries.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=3
AGENT_FOREGROUND_SECONDS=5.5
AGENT_JOB_SECONDS=24
AGENT_MAX_ATTEMPTS=3

# Explicit Ops administrator seed: uv run python -m app.scripts.seed_admin
OPS_ADMIN_EMAIL=
OPS_ADMIN_PASSWORD=
# Set true behind an HTTPS-terminating proxy; HTTPS/non-development always uses Secure.
OPS_COOKIE_SECURE=false
OPS_SESSION_SECONDS=28800
OPS_LOGIN_ATTEMPTS=5
OPS_LOGIN_WINDOW_SECONDS=900
