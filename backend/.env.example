# Existing root ../.env is read automatically. Optional backend/.env overrides it.
POSTGRES_DB=quickdrop
POSTGRES_USER=quickdrop
POSTGRES_PASSWORD=change_me_locally
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# Optional alternative; URL-encode reserved characters if constructing a URL yourself.
# DATABASE_URL=postgresql+asyncpg://quickdrop:replace_me@localhost:5432/quickdrop
# A future Compose backend uses POSTGRES_HOST=postgres instead of localhost.
