# Copy to .env. Never commit real credentials. Backend reads this root file.
# Host processes use these defaults; Compose overrides hosts to its service names.
POSTGRES_DB=quickdrop
POSTGRES_USER=quickdrop
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# Optional host alternative; Compose uses POSTGRES_* instead.
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/quickdrop
REDIS_URL=redis://localhost:6379/0
PAYSWIFT_BASE_URL=http://localhost:8081
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
APP_ENV=development
ENABLE_LOCAL_INTERNAL_READS=false
ENABLE_DEMO_WORKSPACE=true
# Set one shared random secret of 32+ characters for stable Rider cookies across API restarts.
# Blank generates a process-local secret; existing Rider cookies then expire on restart.
DEMO_SESSION_SECRET=
# Required for explicit administrator setup; password must contain 12–1024 characters.
OPS_ADMIN_EMAIL=
OPS_ADMIN_PASSWORD=
OPS_COOKIE_SECURE=false
OPS_SESSION_SECONDS=28800
OPS_LOGIN_ATTEMPTS=5
OPS_LOGIN_WINDOW_SECONDS=900
# Explicit interactive historical demo only; evaluator event timestamps take precedence.
# Rejected outside development. Leave empty for actual event/current time.
APP_REFERENCE_TIME=
LLM_PROVIDER=amazon
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Required only for temporary AWS credentials.
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
BEDROCK_TIMEOUT_SECONDS=10
# Alternative: LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=3
AGENT_FOREGROUND_SECONDS=7
AGENT_JOB_SECONDS=24
AGENT_MAX_ATTEMPTS=3
PAYMENT_POLL_SECONDS=2
PAYMENT_MAX_ATTEMPTS=8
# Host frontend proxy. Compose sets its build/runtime URL to http://api:8000.
BACKEND_URL=http://127.0.0.1:8000
# Optional direct browser API origin: configure in frontend/.env.local, then rebuild.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Optional separate project: COMPOSE_PROJECT_NAME=quickdrop-verification
# Optional host port overrides for independent Compose projects. Internal ports never change.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
PAYSWIFT_HOST_PORT=8081
API_HOST_PORT=8000
FRONTEND_HOST_PORT=3000
